---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "Github", url: "https://github.com/Oxypetalum7" },
  { label: "X", url: "https://x.com/E_oxypetalum_7" },
  { label: "Blog", url: "https://oxypetalum7.github.io/myblog/" },
];

const contacts = [{ label: "E-Mail", url: "mailto:contact@gekka-o.xyz" }];
---

<BaseLayout title="Links・Contacts | Oxypetalum7’s portfolio">
  <div class="links-page">
    <section class="block">
      <h1>Links</h1>
      <div class="buttons wide">
        {
          links.map((link) =>
            link.url ? (
              <a class="button" href={link.url} target="_blank" rel="noopener">
                {link.label}
              </a>
            ) : (
              <span class="button" aria-disabled="true">
                {link.label}
              </span>
            ),
          )
        }
      </div>
    </section>
    <section class="block">
      <h1>Contacts</h1>
      <div class="buttons">
        {
          contacts.map((contact) => (
            <a class="button contact" href={contact.url}>
              {contact.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .links-page {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    gap: 64px;
    align-items: center;
    justify-content: center;
    padding: 64px 16px;
    color: var(--color-text);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    width: 100%;
  }

  .block h1 {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 48px;
  }

  .buttons {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-content: center;
    width: min(360px, 100%);
  }

  .button {
    flex: 1 0 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid #767675;
    border-radius: 4px;
    background: var(--color-black-600);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .button.contact {
    flex: 0 0 auto;
    width: 95px;
  }

  .button:hover {
    background: #4a4a48;
  }

  .button[aria-disabled="true"] {
    opacity: 0.5;
  }
</style>
