---
import BaseLayout from "../layouts/BaseLayout.astro";
import BiographyProfessional from "../components/BiographyProfessional.astro";
import BiographyPersonal from "../components/BiographyPersonal.astro";
---

<BaseLayout title="Biography | Oxypetalum7’s portfolio">
  <div class="biography" data-side="professional">
    <div class="toggle-row">
      <div class="toggle" role="tablist" aria-label="Biographyの表示切替">
        <button
          class="toggle-button"
          id="toggle-professional"
          role="tab"
          aria-selected="true"
        >
          Professional
        </button>
        <button
          class="toggle-button"
          id="toggle-personal"
          role="tab"
          aria-selected="false"
        >
          Personal
        </button>
      </div>
    </div>
    <div id="side-professional" role="tabpanel" aria-labelledby="toggle-professional">
      <BiographyProfessional />
    </div>
    <div id="side-personal" role="tabpanel" aria-labelledby="toggle-personal" hidden>
      <BiographyPersonal />
    </div>
  </div>
</BaseLayout>

<style>
  .biography {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px;
    overflow: clip;
    transition: background-color 0.4s ease;
  }

  .biography[data-side="personal"] {
    background: #ffffff;
  }

  .toggle-row {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .toggle {
    display: flex;
    gap: 16px;
    padding: 8px;
    border-radius: 16px;
    width: min(820px, 100%);
    background: var(--color-black-600);
    box-shadow: inset 0 0 16px 0 rgba(0, 0, 0, 0.25);
    transition: background-color 0.4s ease;
  }

  .toggle-button {
    flex: 1 0 0;
    min-width: 0;
    padding: 16px 36px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 24px;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .toggle-button[aria-selected="true"] {
    border-radius: 12px;
    background: var(--color-background-default);
    box-shadow:
      0 4px 8px 0 rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px black;
  }

  /* Personal側: ライトテーマのトグル */
  .biography[data-side="personal"] .toggle {
    background: #ffffff;
    box-shadow: inset 0 0 16px -4px rgba(0, 0, 0, 0.25);
  }

  .biography[data-side="personal"] .toggle-button {
    color: var(--color-black-600);
  }

  .biography[data-side="personal"] .toggle-button[aria-selected="true"] {
    background: #ffffff;
    box-shadow:
      0 4px 8px -4px rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 700px) {
    .biography {
      padding: 32px 16px;
    }

    .toggle-button {
      padding: 12px 8px;
      font-size: 18px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".biography");
  const buttons = {
    professional: document.getElementById("toggle-professional"),
    personal: document.getElementById("toggle-personal"),
  };
  const panels = {
    professional: document.getElementById("side-professional"),
    personal: document.getElementById("side-personal"),
  };

  type Side = "professional" | "personal";

  function setSide(side: Side) {
    if (!root) return;
    root.dataset.side = side;
    for (const key of ["professional", "personal"] as const) {
      buttons[key]?.setAttribute("aria-selected", String(key === side));
      if (panels[key]) panels[key].hidden = key !== side;
    }
    const url = new URL(location.href);
    url.searchParams.set("side", side);
    history.replaceState(null, "", url);
  }

  buttons.professional?.addEventListener("click", () => setSide("professional"));
  buttons.personal?.addEventListener("click", () => setSide("personal"));

  // URLパラメータで初期表示を切替可能にする
  if (new URLSearchParams(location.search).get("side") === "personal") {
    setSide("personal");
  }
</script>
