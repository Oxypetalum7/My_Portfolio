---
import BaseLayout from "../layouts/BaseLayout.astro";
import BiographyProfessional from "../components/BiographyProfessional.astro";
import BiographyPersonal from "../components/BiographyPersonal.astro";
---

<BaseLayout title="Biography | Oxypetalum7’s portfolio">
  <div class="biography" data-side="professional">
    <div class="toggle-row">
      <button
        class="toggle"
        id="biography-toggle"
        role="switch"
        aria-checked="false"
        aria-label="BiographyをPersonal表示に切り替え"
      >
        <span class="toggle-thumb" aria-hidden="true"></span>
        <span class="toggle-option">Professional</span>
        <span class="toggle-option">Personal</span>
      </button>
    </div>
    <div id="side-professional">
      <BiographyProfessional />
    </div>
    <div id="side-personal" hidden>
      <BiographyPersonal />
    </div>
  </div>
</BaseLayout>

<style>
  .biography {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px;
    overflow: clip;
    transition: background-color 0.4s ease;
  }

  .biography[data-side="personal"] {
    background: #ffffff;
  }

  .toggle-row {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .toggle {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 8px;
    border: none;
    border-radius: 16px;
    width: min(820px, 100%);
    background: var(--color-black-600);
    box-shadow: inset 0 0 16px 0 rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.4s ease;
  }

  /* 選択中ボタンの背景板。ボタン間をスライドする */
  .toggle-thumb {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 8px;
    width: calc(50% - 16px);
    border-radius: 12px;
    background: var(--color-background-default);
    box-shadow:
      0 4px 8px 0 rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px black;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .toggle-option {
    position: relative;
    flex: 1 0 0;
    min-width: 0;
    padding: 16px 36px;
    border-radius: 12px;
    color: var(--color-text);
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 24px;
    transition: color 0.3s ease;
  }

  /* Personal側: ライトテーマのトグル */
  .biography[data-side="personal"] .toggle {
    background: #ffffff;
    box-shadow: inset 0 0 16px -4px rgba(0, 0, 0, 0.25);
  }

  .biography[data-side="personal"] .toggle-option {
    color: var(--color-black-600);
  }

  .biography[data-side="personal"] .toggle-thumb {
    transform: translateX(calc(100% + 16px));
    background: #ffffff;
    box-shadow:
      0 4px 8px -4px rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 700px) {
    .biography {
      padding: 32px 16px;
    }

    .toggle-option {
      padding: 12px 8px;
      font-size: 18px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".biography");
  const toggle = document.getElementById("biography-toggle");
  const panels = {
    professional: document.getElementById("side-professional"),
    personal: document.getElementById("side-personal"),
  };

  type Side = "professional" | "personal";

  function setSide(side: Side) {
    if (!root) return;
    root.dataset.side = side;
    toggle?.setAttribute("aria-checked", String(side === "personal"));
    for (const key of ["professional", "personal"] as const) {
      if (panels[key]) panels[key].hidden = key !== side;
    }
    const url = new URL(location.href);
    url.searchParams.set("side", side);
    history.replaceState(null, "", url);
  }

  toggle?.addEventListener("click", () => {
    setSide(root?.dataset.side === "personal" ? "professional" : "personal");
  });

  // URLパラメータで初期表示を切替可能にする
  if (new URLSearchParams(location.search).get("side") === "personal") {
    setSide("personal");
  }
</script>
