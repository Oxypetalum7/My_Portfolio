---
import BaseLayout from "../layouts/BaseLayout.astro";
import BiographyProfessional from "../components/BiographyProfessional.astro";
import BiographyPersonal from "../components/BiographyPersonal.astro";
---

<BaseLayout title="Biography | Oxypetalum7’s portfolio">
  <div class="biography" data-side="professional">
    <div class="toggle-row">
      <button
        class="toggle"
        id="biography-toggle"
        role="switch"
        aria-checked="false"
        aria-label="BiographyをPersonal表示に切り替え"
      >
        <span class="toggle-thumb" aria-hidden="true"></span>
        <span class="toggle-option">Professional</span>
        <span class="toggle-option">Personal</span>
      </button>
    </div>
    <script is:inline>
      // バンドルされるscript(type=module)はHTMLを最後まで読み終えてから動くため、モバイル回線では
      // 「トグルは見えているのに押せない」時間ができる。トグルの直後で即座にdocumentへクリックを
      // 委譲し、読み込み途中から押せるようにする。ClientRouterは遷移のたびにこのscriptを再実行するので、
      // 登録は一度だけにする
      if (!window.__biographyToggleBound) {
        window.__biographyToggleBound = true;

        const setSide = (root, side) => {
          // 面の出し分けはdata-sideを見るCSSが担う(まだ読み込まれていない面にも効く)
          root.dataset.side = side;
          root.querySelector("#biography-toggle")?.setAttribute("aria-checked", String(side === "personal"));
          const url = new URL(location.href);
          url.searchParams.set("side", side);
          // ClientRouterはhistory.stateに{index, scrollX, scrollY}を保持しており、
          // nullで上書きするとpopstate(スワイプバック等)がルーターに無視されて
          // 以降ページが復元されずトグルも死ぬ。既存stateを維持してURLだけ更新する
          history.replaceState(history.state, "", url);
          document.dispatchEvent(new CustomEvent("biography:sidechange", { detail: { side } }));
        };

        document.addEventListener("click", (event) => {
          const toggle = event.target instanceof Element ? event.target.closest("#biography-toggle") : null;
          const root = toggle?.closest(".biography");
          if (!root) return;
          setSide(root, root.dataset.side === "personal" ? "professional" : "personal");
        });

        // URLパラメータで初期表示を切替可能にする
        document.addEventListener("astro:page-load", () => {
          const root = document.querySelector(".biography");
          if (root && new URLSearchParams(location.search).get("side") === "personal") {
            setSide(root, "personal");
          }
        });
      }
    </script>
    <div id="side-professional">
      <BiographyProfessional />
    </div>
    <div id="side-personal">
      <BiographyPersonal />
    </div>
  </div>
</BaseLayout>

<style>
  .biography {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px;
    overflow: clip;
    transition: background-color 0.4s ease;
  }

  .biography[data-side="personal"] {
    background: #ffffff;
  }

  .biography:not([data-side="personal"]) #side-personal,
  .biography[data-side="personal"] #side-professional {
    display: none;
  }

  .toggle-row {
    display: flex;
    justify-content: center;
    width: 100%;
    /* Personal側のヒーローバンドはトグルの背後まで届くため、トグルを上に出す */
    position: relative;
    z-index: 1;
  }

  .toggle {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 8px;
    border: none;
    border-radius: 16px;
    width: min(820px, 100%);
    background: var(--color-black-600);
    box-shadow: inset 0 0 16px 0 rgba(0, 0, 0, 0.25);
    cursor: pointer;
    /* iOSで素早く切り替えた2回目のタップが、ダブルタップズームに吸われないようにする */
    touch-action: manipulation;
    transition: background-color 0.4s ease;
  }

  /* 選択中ボタンの背景板。ボタン間をスライドする */
  .toggle-thumb {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 8px;
    width: calc(50% - 16px);
    border-radius: 12px;
    background: var(--color-background-default);
    box-shadow:
      0 4px 8px 0 rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px black;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .toggle-option {
    position: relative;
    flex: 1 0 0;
    min-width: 0;
    padding: 16px 36px;
    border-radius: 12px;
    color: var(--color-text);
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 24px;
    transition: color 0.3s ease;
  }

  /* Personal側: ライトテーマのトグル */
  .biography[data-side="personal"] .toggle {
    background: #ffffff;
    box-shadow: inset 0 0 16px -4px rgba(0, 0, 0, 0.25);
  }

  .biography[data-side="personal"] .toggle-option {
    color: var(--color-black-600);
  }

  .biography[data-side="personal"] .toggle-thumb {
    transform: translateX(calc(100% + 16px));
    background: #ffffff;
    box-shadow:
      0 4px 8px -4px rgba(0, 0, 0, 0.25),
      inset 0 0 24px -8px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 700px) {
    .biography {
      padding: 32px 24px;
    }

    /* カンプ準拠: 342×44・角丸8/6・ラベル14px(コンポーネント比率を44px高に換算) */
    .toggle {
      gap: 10px;
      padding: 5px;
      border-radius: 8px;
      width: min(342px, 100%);
      margin-inline: auto;
    }

    .toggle-thumb {
      top: 5px;
      bottom: 5px;
      left: 5px;
      width: calc(50% - 10px);
      border-radius: 6px;
    }

    .biography[data-side="personal"] .toggle-thumb {
      transform: translateX(calc(100% + 10px));
    }

    .toggle-option {
      padding: 8px 4px;
      border-radius: 6px;
      font-size: 14px;
    }
  }
</style>
