---
// RootsArtworkの原画を1層ずつ単体で表示する、画像焼き付け用のページ(scripts/render-roots-artwork.mjs が撮影する)。
// 本番ビルドには出さない
import RootsArtwork from "../../../components/RootsArtwork.astro";
import { ROOTS_LAYERS, type RootsLayer } from "../../../lib/roots";

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return Object.keys(ROOTS_LAYERS).map((layer) => ({ params: { layer } }));
}

const layer = Astro.params.layer as RootsLayer;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: transparent;
      }

      /* 撮影に開発ツールバーが写り込まないようにする */
      astro-dev-toolbar {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <RootsArtwork layer={layer} />
  </body>
</html>
