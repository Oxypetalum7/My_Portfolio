---
import wolfMark from "../assets/brand/wolf-mark.svg";
import navBg from "../assets/brand/nav-header-bg.png";

const navItems = [
  { label: "Biography", href: "/biography" },
  { label: "Job Activity", href: "/job-activity" },
  { label: "Works・Projects", href: "/works" },
  { label: "Links・Contacts", href: "/links" },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-header" style={`background-image: url(${navBg.src})`}>
  <a class="brand" href="/">
    <span class="brand-mark">
      <img src={wolfMark.src} alt="" width="64" height="74" />
    </span>
    <span class="brand-title">Oxypetalum7’s portfolio</span>
  </a>
  <nav class="nav-links" aria-label="メインナビゲーション">
    {
      navItems.map((item, i) => (
        <>
          {i > 0 && <span class="nav-divider" aria-hidden="true" />}
          <a
            href={item.href}
            aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </>
      ))
    }
  </nav>
</header>

<style>
  .nav-header {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    padding: 8px 12px;
    width: 100%;
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-header);
    position: relative;
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-mark {
    width: clamp(56px, 6.7vw, 96px);
    height: clamp(56px, 6.7vw, 96px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-mark img {
    width: 67%;
    height: 77%;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 36px);
    letter-spacing: clamp(2.5px, 0.5vw, 7.2px);
    padding: 0 clamp(6px, 1.1vw, 16px);
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    align-self: stretch;
    min-width: 0;
    padding: 0 clamp(4px, 1.7vw, 24px);
  }

  .nav-links a {
    font-family: var(--font-jp);
    font-weight: 300;
    font-size: clamp(13px, 1.4vw, 20px);
    letter-spacing: clamp(0.6px, 0.17vw, 2.4px);
    padding: 8px clamp(4px, 0.85vw, 12px);
    white-space: nowrap;
  }

  .nav-links a[aria-current="page"] {
    font-weight: 600;
  }

  .nav-divider {
    width: 16px;
    align-self: stretch;
    position: relative;
  }

  .nav-divider::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--color-white-200);
    opacity: 0.5;
  }

  /* モバイル幅のみ2段組(それ以外は常に1行) */
  @media (max-width: 860px) {
    .nav-header {
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links {
      padding: 0;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-divider {
      display: none;
    }
  }
</style>
