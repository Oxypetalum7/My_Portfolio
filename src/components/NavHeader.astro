---
import wolfMark from "../assets/brand/wolf-mark.svg";
import navBg from "../assets/brand/nav-header-bg.png";

const navItems = [
  { label: "Biography", href: "/biography" },
  { label: "Job Activity", href: "/job-activity" },
  { label: "Works・Projects", href: "/works" },
  { label: "Links・Contacts", href: "/links" },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-header" style={`background-image: url(${navBg.src})`}>
  <a class="brand" href="/">
    <span class="brand-mark">
      <img src={wolfMark.src} alt="" width="64" height="74" />
    </span>
    <span class="brand-title">Oxypetalum7’s portfolio</span>
  </a>
  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-links"
    aria-label="メニューを開く"
  >
    <span class="menu-bar" aria-hidden="true"></span>
    <span class="menu-bar" aria-hidden="true"></span>
    <span class="menu-bar" aria-hidden="true"></span>
  </button>
  <nav class="nav-links" id="nav-links" aria-label="メインナビゲーション">
    {
      navItems.map((item, i) => (
        <>
          {i > 0 && <span class="nav-divider" aria-hidden="true" />}
          <a
            href={item.href}
            data-label={item.label}
            aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </>
      ))
    }
  </nav>
</header>

<script is:inline>
  // バンドルされるscript(type=module)はHTMLを最後まで読み終えてから動くため、モバイル回線では
  // 「メニューは見えているのに押せない」時間ができる。ボタンの直後で即座にdocumentへクリックを
  // 委譲し、読み込み途中から押せるようにする。ClientRouterは遷移のたびにこのscriptを再実行するので、
  // 登録は一度だけにする(委譲なのでSPA遷移でDOMが作り直されてもそのまま効く)
  if (!window.__navMenuBound) {
    window.__navMenuBound = true;

    const setOpen = (header, open) => {
      const toggle = header.querySelector("#menu-toggle");
      header.classList.toggle("nav-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
      // ドロワー表示中は背景のスクロールを止める
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const header = target?.closest(".nav-header");
      if (!header) return;
      if (target.closest("#menu-toggle")) {
        setOpen(header, !header.classList.contains("nav-open"));
      } else if (target.closest(".nav-links a")) {
        // リンク選択でドロワーを閉じる(SPA遷移でDOMは作り直されるが、overflow解除のため明示する)
        setOpen(header, false);
      }
    });
  }
</script>

<style>
  .nav-header {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    padding: 8px 12px;
    width: 100%;
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-header);
    position: relative;
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-mark {
    width: clamp(56px, 6.7vw, 96px);
    height: clamp(56px, 6.7vw, 96px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-mark img {
    width: 67%;
    height: 77%;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 36px);
    letter-spacing: clamp(2.5px, 0.5vw, 7.2px);
    padding: 0 clamp(6px, 1.1vw, 16px);
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    align-self: stretch;
    min-width: 0;
    padding: 0 clamp(4px, 1.7vw, 24px);
  }

  .nav-links a {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-jp);
    font-weight: 300;
    font-size: clamp(13px, 1.4vw, 20px);
    letter-spacing: clamp(0.6px, 0.17vw, 2.4px);
    padding: 8px clamp(4px, 0.85vw, 12px);
    white-space: nowrap;
  }

  /* 選択時の太字化で幅が揺れないよう、不可視の太字ダミーで幅を先に確保する */
  .nav-links a::after {
    content: attr(data-label);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 600;
    pointer-events: none;
  }

  .nav-links a[aria-current="page"] {
    font-weight: 600;
  }

  .nav-divider {
    width: 16px;
    align-self: stretch;
    position: relative;
  }

  .nav-divider::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--color-white-200);
    opacity: 0.5;
  }

  /* ハンバーガーボタン。デスクトップでは非表示 */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    margin-left: auto;
    border: none;
    background: none;
    cursor: pointer;
    /* iOSで素早く開閉した2回目のタップが、ダブルタップズームに吸われないようにする */
    touch-action: manipulation;
  }

  .menu-bar {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-text);
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  /* 開いている間はバーを×に変形させる */
  .nav-header.nav-open .menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-header.nav-open .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-header.nav-open .menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* モバイル幅はハンバーガー+全面ドロワーに切り替える */
  @media (max-width: 860px) {
    .nav-header {
      padding: 8px 15px 8px 24px;
    }

    .brand-title {
      padding-left: 12px;
    }

    .menu-toggle {
      display: flex;
    }

    .nav-divider {
      display: none;
    }

    .nav-links {
      position: fixed;
      inset: 0;
      z-index: -1; /* ヘッダー(z-index:10)の下に潜らせ、ロゴと×は常に見せる */
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 12px;
      padding: 112px 28px 48px;
      background: var(--color-background-default);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
    }

    .nav-header.nav-open .nav-links {
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      padding: 8px 0;
      font-size: 18px;
      letter-spacing: 1.8px;
    }
  }
</style>
