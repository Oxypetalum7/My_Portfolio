---
import wolfMark from "../assets/brand/wolf-mark.svg";
import navBg from "../assets/brand/nav-header-bg.png";

const navItems = [
  { label: "Biography", href: "/biography" },
  { label: "Job Activity", href: "/job-activity" },
  { label: "Works・Projects", href: "/works" },
  { label: "Links・Contacts", href: "/links" },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-header" style={`background-image: url(${navBg.src})`}>
  <a class="brand" href="/">
    <span class="brand-mark">
      <img src={wolfMark.src} alt="" width="64" height="74" />
    </span>
    <span class="brand-title">Oxypetalum7’s portfolio</span>
  </a>
  <nav class="nav-links" aria-label="メインナビゲーション">
    {
      navItems.map((item, i) => (
        <>
          {i > 0 && <span class="nav-divider" aria-hidden="true" />}
          <a
            href={item.href}
            aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </>
      ))
    }
  </nav>
</header>

<style>
  .nav-header {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 8px 12px;
    width: 100%;
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-header);
    position: relative;
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand-mark {
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-mark img {
    width: 64px;
    height: 74px;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 36px;
    letter-spacing: 7.2px;
    padding: 0 16px;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 0 24px;
  }

  .nav-links a {
    font-family: var(--font-jp);
    font-weight: 300;
    font-size: 20px;
    letter-spacing: 2.4px;
    padding: 8px 12px;
    white-space: nowrap;
  }

  .nav-links a[aria-current="page"] {
    font-weight: 600;
  }

  .nav-divider {
    width: 16px;
    align-self: stretch;
    position: relative;
  }

  .nav-divider::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--color-white-200);
    opacity: 0.5;
  }

  @media (max-width: 1100px) {
    .nav-header {
      justify-content: center;
    }

    .brand-mark {
      width: 56px;
      height: 56px;
    }

    .brand-mark img {
      width: 40px;
      height: 46px;
    }

    .brand-title {
      font-size: 26px;
      letter-spacing: 4px;
    }

    .nav-links {
      padding: 0;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      font-size: 16px;
      letter-spacing: 1.6px;
    }

    .nav-divider {
      display: none;
    }
  }
</style>
