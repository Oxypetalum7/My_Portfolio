  /* ハードライトで暗部を夜色に沈め、琥珀や赤橙の明部だけを灯らせる */
  .forest-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: var(--forest-fade);
    mix-blend-mode: overlay;
  }

  /* 奥の層ほど暗く沈める(霞みは間に挟んだ靄が担う) */
  .forest-far {
    opacity: calc(0.45 * var(--forest-opacity));
    filter: brightness(0.65);
  }

  .forest-mid {
    opacity: calc(0.85 * var(--forest-opacity));
