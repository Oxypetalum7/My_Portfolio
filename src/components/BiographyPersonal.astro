      #f8f6fa calc(100% - var(--dawn-h) * 0.125),
      #ffffff 100%
    );
  }

  .forest-defs {
    position: absolute;
  }

  /* 本文(左)にかからないよう右側の余白に森を置く。フェード区間では森も霞ませる。
     木を背景の夜色とブレンドさせるため、.forest自体にはマスク・透明度をかけず(合成グループが
     閉じてしまう)、フェードと濃さは変数で各層に配る */
  .forest {
    --forest-opacity: 1;
    --forest-fade: linear-gradient(
      to bottom,
      transparent calc(var(--night-fade-in) * 0.6),
      #000 calc(var(--night-fade-in) + 80px),
      #000 calc(100% - var(--night-fade-out) - 40px),
      transparent calc(100% - 60px)
    );
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: min(46%, 760px);
  }

  /* ハードライトで暗部を夜色に沈め、琥珀や赤橙の明部だけを灯らせる */
  .forest-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: var(--forest-fade);
    mix-blend-mode: overlay;
  }

  /* 奥の層ほど暗く沈める(霞みは間に挟んだ靄が担う) */
  .forest-far {
    opacity: calc(0.45 * var(--forest-opacity));
    filter: brightness(0.65);
  }

  .forest-mid {
    opacity: calc(0.85 * var(--forest-opacity));
    filter: brightness(0.85);
  }

  .forest-near {
    opacity: var(--forest-opacity);
  }

  /* 靄はゆっくり左右に流す。層の左右端が板のように切れて見えないよう、
     上下のフェードに加えて横方向のフェードもかける。ソフトライトで光らせずに空気として馴染ませる */
  .mist {
    --mist-duration: 60s;
    --mist-direction: alternate;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: mist-drift var(--mist-duration) ease-in-out infinite var(--mist-direction);
    mask-image:
      linear-gradient(to right, transparent, #000 40%, #000 88%, transparent),
      var(--forest-fade);
    mask-composite: intersect;
    mix-blend-mode: soft-light;
  }

  .mist-far {
    opacity: var(--forest-opacity);
  }

  .mist-mid {
    --mist-duration: 45s;
    --mist-direction: alternate-reverse;
    opacity: calc(0.7 * var(--forest-opacity));
  }

  @keyframes mist-drift {
    from {
      translate: -4% 0;
    }

    to {
      translate: 4% 0;
    }
  }

  /* スクロールに合わせ、手前の層ほど速く上へ流して「奥から手前へ過ぎ去る」奥行きを出す。
     靄は輪郭が淡く動きが見えにくいため、森より大きめに流す(横流しのtranslateと干渉しないようtransformで動かす) */
  @supports (animation-timeline: view()) {
    .forest-layer {
      animation: forest-drift linear both;
      animation-timeline: view();
    }

    .forest-far {
      --drift: 30px;
    }

    .forest-mid {
      --drift: 130px;
    }

    .forest-near {
      --drift: 280px;
    }

    .mist {
      animation:
        mist-drift var(--mist-duration) ease-in-out infinite var(--mist-direction),
        mist-parallax linear both;
      animation-timeline: auto, view();
    }

    .mist-far {
      --drift: 180px;
    }

    .mist-mid {
      --drift: 420px;
    }
  }

  @keyframes forest-drift {
    from {
      translate: 0 var(--drift);
    }

    to {
      translate: 0 calc(var(--drift) * -1);
    }
  }

  @keyframes mist-parallax {
    from {
      transform: translateY(var(--drift));
    }

    to {
      transform: translateY(calc(var(--drift) * -1));
    }
  }

  /* 月。草と同じくstickyで夜の間は画面に留め、--roots の進み具合で弧を描いて昇り沈む。
     夕闇・夜明けのグラデーションの上には出さず、空が暗い所でだけ見えるよう位置基準でマスクする
     (スクロール連動が使えない環境では、南中の位置に置いたままこのマスクだけで出入りさせる) */
  .moon-frame {
    --moon-mask: linear-gradient(
      to bottom,
      transparent calc(var(--dusk-h) * 0.55),
      #000 calc(var(--dusk-h) + 60px),
      #000 calc(100% - var(--dawn-h) - 120px),
      transparent calc(100% - var(--dawn-h))
    );
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: var(--moon-mask);
  }

  .moon-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
  }

  /* 横位置は森の通り道に合わせてスクリプトが --moon-x に入れる(未計測の間は右寄りの仮位置) */
  .moon {
    --moon-size: clamp(72px, 7.5vw, 128px);
    position: absolute;
    top: 13vh;
    left: calc(var(--moon-x, 76%) - var(--moon-size) / 2);
    width: var(--moon-size);
    aspect-ratio: 1;
  }

  .moon-disc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 calc(var(--moon-size) * 0.06) rgb(255 246 226 / 0.7));
  }

  /* 月暈。月の周りの夜空を淡く照らし、外へ行くほど青紫の夜に溶かす */
  .moon-halo {
    position: absolute;
    inset: -260%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(244 238 255 / 0.7) 0,
      rgb(200 188 248 / 0.36) 12%,
      rgb(146 130 224 / 0.16) 26%,
      rgb(104 90 194 / 0.06) 42%,
      transparent 62%
    );
    mix-blend-mode: screen;
  }

  @supports (animation-timeline: view()) {
    .moon {
      animation: moon-arc linear both;
      animation-timeline: --roots;
      /* 夜が画面の1/4ほどを満たしてから昇り始め、夜の背景の下端が画面下に着く頃に沈み切る */
      animation-range: cover calc(var(--night-fade-in) + 25vh) exit 0%;
    }
  }

  /* 森の通り道の奥から昇り、南中を過ぎたら夜明けの方へ沈む。
     横に流すと通り道の脇の木に掛かるため、縦の動きだけにする */
  @keyframes moon-arc {
    0% {
      opacity: 0;
      translate: 0 34vh;
    }

    12% {
      opacity: 1;
    }

    30% {
      translate: 0 7vh;
    }

    50% {
      translate: 0 0;
    }

    70% {
      translate: 0 7vh;
    }

    88% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      translate: 0 34vh;
    }
  }

  /* 周辺減光。stickyで画面に留め、夜の背景の上でだけ見えるよう夕闇・夜明けの区間はマスクで消す */
  .vignette-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(
      to bottom,
      transparent calc(var(--dusk-h) * 0.5),
      #000 calc(var(--dusk-h) + 40px),
      #000 calc(100% - var(--dawn-h) - 40px),
      transparent calc(100% - var(--dawn-h) * 0.4)
    );
  }

  .vignette {
    position: sticky;
    top: 0;
    height: 100vh;
    background: radial-gradient(
      ellipse 75% 70% at 50% 45%,
      transparent 45%,
      rgb(3 4 20 / 0.24) 70%,
      rgb(3 4 20 / 0.52) 100%
    );
  }

  /* 草の影。stickyで夜の間は画面下に留まり、夜に入る時は下からせり上がる。
     スクロール連動が使えない環境では、夜明けのフェード区間でマスクして消す */
  .grass-frame {
    --grass-mask: linear-gradient(
      to bottom,
      transparent calc(var(--night-fade-in) * 0.5),
      #000 var(--night-fade-in),
      #000 calc(100% - var(--night-fade-out) * 0.35),
      transparent 100%
    );
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: var(--grass-mask);
  }

  /* 位置基準のマスクだと根元から先に消えて穂先が宙に浮くため、草全体をフェードさせる。
     夜明けの間は明けていく空に逆光のシルエットとして残し、夜の背景の下端(ここで草が
     切り落とされる)に着く直前で消す */
  @supports (animation-timeline: view()) {
    .roots-night {
      view-timeline: --roots;
    }

    .grass-frame {
      mask-image: none;
    }

    .grass-sticky {
      animation: grass-fade linear both;
      animation-timeline: --roots;
      animation-range: cover var(--night-fade-in) exit 0%;
    }
  }

  @keyframes grass-fade {
    0% {
      opacity: 0;
    }

    18%,
    90% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  .grass-sticky {
    --grass-h: min(74vh, 720px);
    position: sticky;
    top: 0;
    height: 100vh;
  }

  /* 根元は画面下に見切れさせ、草の上側だけが覗き込むように見せる。
     沈めた分の見え幅を保つため、草自体は少し大きめにする。左右は画面外へ少しはみ出させ、
     奥の株ほど薄くして夜の空気に溶かす */
  .grass {
    --h: calc(var(--grass-h) * var(--scale));
    position: absolute;
    bottom: calc(var(--h) * -0.24);
    height: var(--h);
    aspect-ratio: var(--grass-ratio);
    background: #05061c;
    opacity: var(--shade);
    mask: var(--grass) bottom / 100% 100% no-repeat;
    transform-origin: 50% 100%;
    transform: rotate(var(--tilt)) scaleX(var(--flip-x, 1));
  }

  .grass.flip {
    --flip-x: -1;
  }

  /* 左上の角から垂れ下がる花。付け根側は画面の外へ少し逃がし、枝先だけが垂れて見えるようにする。
     色は草の影と同じにして、夜空に溶け込む控えめな主張にそろえる。
     手前でピントの外れた枝に見えるよう軽くぼかす(マスクより後に掛けるため、外側の要素のfilterで付ける) */
  .agave-blur {
    position: absolute;
    top: 0;
    left: 0;
    filter: blur(2px);
  }

  .agave {
    --agave-h: min(32vh, 300px);
    position: absolute;
    top: calc(var(--agave-h) * -0.06);
    left: calc(var(--agave-h) * -0.08);
    height: var(--agave-h);
    aspect-ratio: var(--agave-ratio);
    background: #05061c;
    opacity: 0.8;
    mask: var(--agave) top left / 100% 100% no-repeat;
  }

  /* 夕闇のベール。.night-band の夕闇区間と同じ色・位置のグラデーションに、上ほど不透明になる
     透明度を持たせて花の上へ重ねる。背景だけの所は変わらず、花だけが白からの遷移に沈んで見える */
  .dusk-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--dusk-h);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 1) 0%,
      rgb(250 248 252 / 0.98) 8.3%,
      rgb(236 232 245 / 0.93) 16.7%,
      rgb(218 211 236 / 0.84) 25%,
      rgb(198 189 225 / 0.74) 33.3%,
      rgb(168 159 207 / 0.62) 41.7%,
      rgb(131 125 184 / 0.5) 50%,
      rgb(96 94 160 / 0.38) 58.3%,
      rgb(72 71 139 / 0.26) 66.7%,
      rgb(52 53 118 / 0.16) 75%,
      rgb(34 36 96 / 0.07) 83.3%,
      rgb(21 24 79 / 0.02) 91.7%,
      rgb(16 19 72 / 0) 100%
    );
  }

  /* 夜明けのベール。.night-band の夜明け区間と同じ色・位置のグラデーションに透明度を持たせて
     草の上へ重ねる。背景だけの所は同色が重なるので変わらず、草だけが明けていく空に覆われて消える */
  .dawn-veil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--dawn-h);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(46 31 82 / 0) 0,
      rgb(54 39 90 / 0.09) 12.5%,
      rgb(73 60 112 / 0.25) 25%,
      rgb(102 90 142 / 0.42) 37.5%,
      rgb(139 129 177 / 0.59) 50%,
      rgb(189 179 212 / 0.75) 62.5%,
      rgb(228 221 239 / 0.88) 75%,
      rgb(248 246 250 / 0.97) 87.5%,
      #ffffff 100%
    );
  }

  .fireflies {
    position: absolute;
    inset: 0;
  }

  .firefly {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: #9a8bff;
    box-shadow: 0 0 6px 2px rgba(130, 112, 255, 0.55);
    opacity: 0;
    animation:
      firefly-float var(--duration) ease-in-out var(--delay) infinite alternate,
      firefly-glow calc(var(--duration) * 0.6) ease-in-out var(--delay) infinite;
  }

  @keyframes firefly-float {
    from {
      translate: 0 0;
    }

    to {
      translate: 18px -36px;
    }
  }

  @keyframes firefly-glow {
    0%,
    100% {
      opacity: 0.1;
    }

    50% {
      opacity: 0.85;
    }
  }

  /* 写真コラージュ。約1280pxを超えた分の60%だけ右端から内側へ連続的に寄せていき、
     どの解像度でも右端張り付き・はみ出しにならないようにする。拡大も幅に比例(上限1.25倍) */
  .photo-collage {
    position: absolute;
    top: 0;
    right: max(-32px, calc(60vw - 800px));
    width: 400px;
    pointer-events: none;
    transform-origin: top right;
    scale: clamp(1, calc(100vw / 1512px), 1.25);
  }

  .polaroid {
    margin: 0;
    position: absolute;
    border: 6px solid #ffffff;
    box-shadow: 3px 6px 8px 0 rgba(0, 0, 0, 0.25);
    background: #fff;
  }

  /* 彩度を抑え少し明るく・淡くして、ミルキーに霞ませる(枠と影の立体感は残す) */
  .polaroid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(1.08) contrast(0.92);
    opacity: 0.85;
  }

  .p1 {
    width: 273px;
    height: 182px;
    right: 60px;
    top: 14px;
    transform: rotate(-7.5deg);
  }

  .p2 {
    width: 338px;
    height: 226px;
    right: -60px;
    top: 182px;
    transform: rotate(15.77deg);
  }

  .p3 {
    width: 273px;
    height: 182px;
    right: -100px;
    top: 452px;
    transform: rotate(-16.67deg);
  }

  /* スクロールで右から投げ入れるアニメーション */
  [data-throw-in] {
    opacity: 0;
  }

  :global(.throw-in-visible) .p1,
  :global(.throw-in-visible) .p2,
  :global(.throw-in-visible) .p3 {
    animation: throw-in 1.7s cubic-bezier(0.22, 0.9, 0.42, 1) forwards;
  }

  :global(.throw-in-visible) .p2 {
    animation-delay: 0.4s;
  }

  :global(.throw-in-visible) .p3 {
    animation-delay: 0.8s;
  }

  @keyframes throw-in {
    from {
      opacity: 0;
      translate: 360px 0;
      rotate: 24deg;
    }

    to {
      opacity: 1;
      translate: 0 0;
      rotate: 0deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-throw-in],
    .hero-band {
      opacity: 1;
      animation: none !important;
    }

    .forest-layer,
    .mist,
    .grass-sticky,
    .moon {
      animation: none !important;
    }

    /* スクロール連動のフェードを止めるため、位置基準のマスクに戻す */
    .grass-frame {
      mask-image: var(--grass-mask) !important;
    }

    .moon-frame {
      mask-image: var(--moon-mask) !important;
    }

    .firefly {
      opacity: 0.5;
      animation: none;
    }
  }

  @media (max-width: 1250px) {
    .photo-collage {
      position: static;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
      padding: 16px 0;
    }

    .polaroid {
      position: static;
      width: min(273px, 80vw);
      height: auto;
    }

    /* 右余白が無くなる幅では、森を本文の背後に薄く敷く */
    .forest {
      --forest-opacity: 0.35;
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    /* カンプ準拠: 札幌テレビ塔の時計を見せ場にしたヒーローバンド。
       トグルの背後から始まり、縦方向の白フェードでProfile本文へ溶ける */
    .hero-band {
      top: -108px; /* biographyの上パディング+トグル分だけ上へ延ばし、トグルを帯上に乗せる */
      bottom: auto;
      height: 296px;
      left: -24px;
      right: -24px;
      filter: blur(2px);
    }

    /* 時計+Panasonicサインが帯の中央(トグル下の抜けゾーン)に来る固定クロップ。
       カンプ(390px幅時: 画像590px幅・x=-160・y=-67)の構図を全モバイル幅で維持する */
    .hero-band img {
      --hero-w: 590px;
      right: auto;
      left: calc(35% - 240px); /* テレビ塔の時計+Panasonicサインが中央左に来る構図 */
      top: 41px; /* バンド上端(-108px)基準。時計が帯内y≈150に来る */
    }

    .hero-band-fade {
      background: linear-gradient(
        to bottom,
        #ffffff 0%,
        rgba(255, 255, 255, 0.82) 14%,
        rgba(255, 255, 255, 0.05) 42%,
        rgba(255, 255, 255, 0.55) 78%,
        #ffffff 100%
      );
    }

    /* 帯の見せ場と本文が重ならないよう、Profileの開始を下げる */
    .bio-personal > .section:first-child {
      padding-top: 132px;
    }

    .h-section,
    .name {
      font-size: 26px;
    }

    .lead,
    .h-item {
      font-size: 20px;
    }

    /* カンプ準拠: インデントは12pxステップ階層 */
    .indent {
      padding-left: 12px;
    }

    .desc,
    .desc-block {
      padding-left: 12px;
    }

    .roots-night {
      --night-fade-in: 140px;
      --night-fade-out: 180px;
    }

    .night-band {
      inset: 0 -24px;
    }

    .grass-sticky {
      --grass-h: min(46vh, 380px);
    }

    .agave {
      --agave-h: min(22vh, 180px);
    }

    .detail-list {
      padding-left: 20px;
    }

    /* カンプ準拠: ポラロイド3枚の重なりコラージュ+白ベールで淡く馴染ませる */
    .photo-collage {
      position: relative;
      display: block;
      width: 100%;
      max-width: 390px;
      height: 215px;
      margin-inline: auto;
      padding: 0;
      scale: 1;
      pointer-events: none;
    }

    .photo-collage::after {
      content: "";
      position: absolute;
      inset: -10px;
      background: radial-gradient(
        ellipse at center,
        rgba(255, 255, 255, 0.22) 0%,
        rgba(255, 255, 255, 0.38) 62%,
        rgba(255, 255, 255, 0.75) 100%
      );
    }

    .polaroid {
      position: absolute;
      border-width: 4px;
    }

    .p1 {
      width: 150px;
      height: 100px;
      left: 0;
      right: auto;
      top: 30px;
      transform: rotate(-7.5deg);
    }

    .p2 {
      width: 170px;
      height: 113px;
      left: calc(50% - 85px);
      right: auto;
      top: 55px;
      z-index: 2;
      transform: rotate(15.77deg);
    }

    .p3 {
      width: 150px;
      height: 100px;
      left: auto;
      right: 0;
      top: 25px;
      transform: rotate(-16.67deg);
    }

    /* デスクトップの行長に合わせた手動改行はスマホでは二重折り返しになるため、
       自然な折り返しに任せる */
    .desc br,
    .desc-block br {
      display: none;
    }
  }
</style>

<script>
  // Roots背景の森・靄は、数千のパスに重いSVGフィルターがかかっており、インラインのままだと
  // スクロールのたびに再描画されて重い。defsごと独立したSVG画像に書き出して<img>に差し替え、
  // 一度だけラスタライズさせる(viewBox付きなので拡縮しても再ラスタライズで鮮明さは保たれる)
  function rasterizeForest() {
    const defs = document.querySelector(".forest-defs defs");
    if (!defs) return;
    const serializer = new XMLSerializer();
    for (const svg of document.querySelectorAll<SVGSVGElement>(".forest-layer, .mist")) {
      const clone = svg.cloneNode(true) as SVGSVGElement;
      clone.prepend(defs.cloneNode(true));
      clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      const blob = new Blob([serializer.serializeToString(clone)], { type: "image/svg+xml" });
      const img = document.createElement("img");
      img.src = URL.createObjectURL(blob);
      img.alt = "";
      img.decoding = "async";
      // スコープ付きCSS(data-astro-cid-*)が効くよう、classと属性を引き継ぐ
      for (const attr of svg.attributes) {
        if (attr.name === "class" || attr.name.startsWith("data-astro-cid")) {
          img.setAttribute(attr.name, attr.value);
        }
      }
      img.addEventListener("load", () => svg.replaceWith(img), { once: true });
    }
  }

  document.addEventListener("astro:page-load", rasterizeForest);

  // 月を森の通り道(viewBox上の x = data-lane)の真上に置く。森はxMaxYMid meetで描かれるので、
  // 表示倍率を求めて通り道の画面上の位置を割り出す。森の大きさが変わるたびと、
  // Personal側が表示された時(非表示の間は測れない)に測り直す
  let moonObserver: ResizeObserver | undefined;
  let updateMoon = () => {};
  function placeMoon() {
    moonObserver?.disconnect();
    const forest = document.querySelector<HTMLElement>(".forest");
    const sticky = document.querySelector<HTMLElement>(".moon-sticky");
    if (!forest || !sticky) return;
    const lane = Number(sticky.dataset.lane);
    const update = (updateMoon = () => {
      const f = forest.getBoundingClientRect();
      if (f.width === 0) return;
      const scale = Math.min(f.width / 600, f.height / 1300);
      const laneX = f.right - (600 - lane) * scale;
      sticky.style.setProperty("--moon-x", `${laneX - sticky.getBoundingClientRect().left}px`);
    });
    update();
    moonObserver = new ResizeObserver(update);
    moonObserver.observe(forest);
  }

  document.addEventListener("astro:page-load", placeMoon);
  document.addEventListener("biography:sidechange", () => updateMoon());

  // .photo-collage は高さ0のコンテナのため threshold は使えない。
  // rootMargin で「コンテナ上端がビューポート下から35%の線を越えたら」発火させる
  let observer: IntersectionObserver | null = null;

  function arm(collage: Element) {
    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("throw-in-visible");
            observer?.disconnect();
          }
        }
      },
      { rootMargin: "0px 0px -35% 0px" },
    );
    observer.observe(collage);
  }

  // ClientRouterによるSPA遷移後もDOMを取り直せるよう、astro:page-loadごとに初期化する
  document.addEventListener("astro:page-load", () => {
    const collage = document.querySelector(".photo-collage");
    if (collage) arm(collage);
  });

  // Professional側へ切り替わったらリセットし、次にPersonalへ戻った時も
  // スクロール位置に応じて再発火させる
  document.addEventListener("biography:sidechange", (event) => {
    const collage = document.querySelector(".photo-collage");
    if (!collage) return;
    if ((event as CustomEvent).detail?.side !== "personal") {
      collage.classList.remove("throw-in-visible");
      arm(collage);
    }
  });
</script>
